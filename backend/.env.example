# Cle API Anthropic (console.anthropic.com) - distincte de ton abonnement Claude Code.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Nombre de questions gratuites par appareil et par jour.
DAILY_FREE_LIMIT=5

# Plafond d'usage raisonnable de l'illimite, par jour (une photo ou un PDF
# compte double) : protege la marge, chaque question coutant un appel IA.
PREMIUM_DAILY_LIMIT=40

# Plafond mensuel de depense IA du gratuit, en dollars (35 $ = environ 20 000 F).
# Une fois atteint, les eleves non abonnes passent a FREE_LIMIT_OVER_BUDGET
# questions par jour jusqu'a la fin du mois ; les abonnes ne sont pas concernes.
FREE_MONTHLY_BUDGET_USD=35
FREE_LIMIT_OVER_BUDGET=2

# Modele utilise pour les reponses (Haiku 5.5 : rapide et ~6x moins cher que Haiku 4.5).
# Retour arriere possible : ASSISTANT_MODEL=claude-haiku-4-5-20251001
ASSISTANT_MODEL=claude-haiku-5-5

# Niveau de reflexion de Haiku 5.5 (low = rapide et economique).
ASSISTANT_EFFORT=low

PORT=5000

# --- Abonnement CinetPay (facultatif tant que non configure) ---
# Cles obtenues depuis le tableau de bord CinetPay une fois le compte marchand actif.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# URL PUBLIQUE (pas localhost) de ce backend une fois deploye - obligatoire
# pour que CinetPay puisse confirmer les paiements. Ex: https://api.leprofesseur.com
PUBLIC_BASE_URL=

# Prix de l'abonnement illimite, en FCFA/mois (hypothese de depart, a valider).
SUBSCRIPTION_PRICE_FCFA=1000

# --- Bibliotheque de vrais sujets PDF ---
# Chaine secrete de ton choix (ex: genere avec `python -c "import secrets; print(secrets.token_hex(24))"`)
# Necessaire pour ajouter/supprimer des PDF via /api/admin/pdf-sujets.
ADMIN_TOKEN=

# --- Surveillance d'erreurs (facultatif) ---
# Cree un compte gratuit sur https://sentry.io, un projet "Flask", et colle
# le DSN fourni ici. Sans cette variable, aucune erreur n'est envoyee nulle
# part (comportement actuel) - le backend fonctionne normalement.
SENTRY_DSN=
