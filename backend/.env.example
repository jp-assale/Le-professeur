# Cle API Anthropic (console.anthropic.com) - distincte de ton abonnement Claude Code.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Nombre de questions gratuites par appareil et par jour.
DAILY_FREE_LIMIT=5

# Modele utilise pour les reponses (Haiku = rapide et economique).
ASSISTANT_MODEL=claude-haiku-4-5-20251001

PORT=5000

# --- Abonnement CinetPay (facultatif tant que non configure) ---
# Cles obtenues depuis le tableau de bord CinetPay une fois le compte marchand actif.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# URL PUBLIQUE (pas localhost) de ce backend une fois deploye - obligatoire
# pour que CinetPay puisse confirmer les paiements. Ex: https://api.leprofesseur.com
PUBLIC_BASE_URL=

# Prix de l'abonnement illimite, en FCFA/mois (hypothese de depart, a valider).
SUBSCRIPTION_PRICE_FCFA=1000
